{
  "name": "dji-thermal-ui-dev",
  "description": "The pages' front end (TypeScript, Preact, Vite) and its tests and lint, on the host only; the build goes into the package's static/dist",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test:old": "jest"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src/dji_thermal_ui/static/__tests__"
    ]
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "leaflet": "1.9.4",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/leaflet": "1.9.22",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
